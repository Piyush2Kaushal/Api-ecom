[
  {
    "name": "theme_info",
    "theme_name": "Wholesome Pinni",
    "theme_version": "1.0.0",
    "theme_author": "The Wholesome Pinni Co.",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Logo & favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Leave empty to use the logo bundled with the theme. Upload a high-resolution PNG or SVG for the sharpest result."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width (desktop)",
        "min": 60,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 110
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "label": "Logo width (mobile)",
        "min": 50,
        "max": 140,
        "step": 2,
        "unit": "px",
        "default": 76
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 × 32 px PNG recommended."
      }
    ]
  },
  {
    "name": "Colours",
    "settings": [
      {
        "type": "header",
        "content": "Backgrounds"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#FFF8EC"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Alternate section background (peach)",
        "default": "#F8E6D0"
      },
      {
        "type": "color",
        "id": "color_card",
        "label": "Card background",
        "default": "#FFFFFF"
      },
      {
        "type": "header",
        "content": "Text"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Body text",
        "default": "#3B2417"
      },
      {
        "type": "color",
        "id": "color_heading",
        "label": "Headings",
        "default": "#4E3318"
      },
      {
        "type": "header",
        "content": "Brand"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (maroon)",
        "default": "#5C1A1B"
      },
      {
        "type": "color",
        "id": "color_primary_contrast",
        "label": "Text on primary",
        "default": "#FFF8EC"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (saffron gold)",
        "default": "#C8902E"
      },
      {
        "type": "color",
        "id": "color_peach",
        "label": "Soft peach",
        "default": "#F6D9BF"
      },
      {
        "type": "color",
        "id": "color_footer_bg",
        "label": "Footer background",
        "default": "#3B2417"
      },
      {
        "type": "color",
        "id": "color_footer_text",
        "label": "Footer text",
        "default": "#F8E6D0"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale badge",
        "default": "#5C1A1B"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "playfair_display_n7"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "lato_n4"
      },
      {
        "type": "range",
        "id": "font_body_scale",
        "label": "Body text size",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "font_heading_scale",
        "label": "Heading size",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout & style",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Maximum page width",
        "min": 1100,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1320
      },
      {
        "type": "range",
        "id": "card_radius",
        "label": "Card corner radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 18
      },
      {
        "type": "range",
        "id": "button_radius",
        "label": "Button corner radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 40
      },
      {
        "type": "checkbox",
        "id": "animations_enabled",
        "label": "Enable fade-in on scroll animations",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_motif",
        "label": "Show gold ornament dividers",
        "default": true
      }
    ]
  },
  {
    "name": "Shipping & cart",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold (£)",
        "default": 75,
        "info": "Single source of truth for every 'free shipping' message in the theme. Your real shipping rates must also be set in Settings › Shipping and delivery."
      },
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "default": "drawer",
        "options": [
          {
            "value": "drawer",
            "label": "Slide-out drawer"
          },
          {
            "value": "page",
            "label": "Cart page"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "cart_show_notes",
        "label": "Show order note on cart page",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_low_stock",
        "label": "Show 'Only X left' when stock is low",
        "default": true
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "label": "Low stock threshold",
        "min": 1,
        "max": 20,
        "step": 1,
        "default": 5
      }
    ]
  },
  {
    "name": "Contact details",
    "settings": [
      {
        "type": "text",
        "id": "contact_phone",
        "label": "Phone number",
        "info": "Leave empty to hide the phone number everywhere."
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "Email address",
        "info": "Shown in footer and contact page. Leave empty to hide."
      },
      {
        "type": "textarea",
        "id": "contact_address",
        "label": "Business address",
        "info": "Optional. Leave empty to hide."
      },
      {
        "type": "text",
        "id": "contact_hours",
        "label": "Support hours",
        "default": "Monday – Saturday, 10am – 6pm (UK)"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "paragraph",
        "content": "Only icons with a link are shown. Paste full URLs, e.g. https://www.instagram.com/yourhandle"
      },
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "social_pinterest_link",
        "label": "Pinterest"
      },
      {
        "type": "url",
        "id": "social_whatsapp_link",
        "label": "WhatsApp",
        "info": "e.g. https://wa.me/447XXXXXXXXX"
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "Show quick add button",
        "default": true
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "default": "portrait",
        "options": [
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait (4:5)"
          }
        ]
      }
    ]
  },
  {
    "name": "Search engine",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default social sharing image",
        "info": "Used when a page has no image of its own. 1200 × 628 px recommended."
      },
      {
        "type": "text",
        "id": "seo_title_suffix",
        "label": "Title suffix",
        "default": "The Wholesome Pinni Co."
      },
      {
        "type": "textarea",
        "id": "seo_default_description",
        "label": "Fallback meta description",
        "default": "Handmade Punjabi pinni and panjeeri made in the UK with pure desi ghee, dry fruits and traditional family recipes. Delivered fresh across the UK."
      }
    ]
  }
]