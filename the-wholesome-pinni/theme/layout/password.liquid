<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {%- render 'meta-tags' -%}
    {% style %}
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      {{ settings.font_body | font_face: font_display: 'swap' }}
      :root {
        --color-bg: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-card: {{ settings.color_card }};
        --color-text: {{ settings.color_text }};
        --color-text-rgb: {{ settings.color_text.red }}, {{ settings.color_text.green }}, {{ settings.color_text.blue }};
        --color-heading: {{ settings.color_heading }};
        --color-primary: {{ settings.color_primary }};
        --color-primary-rgb: {{ settings.color_primary.red }}, {{ settings.color_primary.green }}, {{ settings.color_primary.blue }};
        --color-primary-contrast: {{ settings.color_primary_contrast }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-rgb: {{ settings.color_accent.red }}, {{ settings.color_accent.green }}, {{ settings.color_accent.blue }};
        --color-peach: {{ settings.color_peach }};
        --color-footer-bg: {{ settings.color_footer_bg }};
        --color-footer-text: {{ settings.color_footer_text }};
        --color-sale: {{ settings.color_sale }};
        --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --font-heading-weight: {{ settings.font_heading.weight }};
        --font-heading-style: {{ settings.font_heading.style }};
        --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        --font-body-weight: {{ settings.font_body.weight }};
        --font-body-weight-bold: 700;
        --font-body-scale: {{ settings.font_body_scale | divided_by: 100.0 }};
        --font-heading-scale: {{ settings.font_heading_scale | divided_by: 100.0 }};
        --page-width: {{ settings.page_width }}px;
        --radius-card: {{ settings.card_radius }}px;
        --radius-button: {{ settings.button_radius }}px;
        --logo-width: {{ settings.logo_width }}px;
        --logo-width-mobile: {{ settings.logo_width_mobile }}px;
      }
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent" class="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
