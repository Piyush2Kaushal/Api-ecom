{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- assign value = gift_card.initial_value | money -%}
    <title>{{ 'gift_cards.issued.title' | t: value: value, shop: shop.name | strip_html | escape }}</title>
    <meta name="description" content="{{ shop.name | escape }} gift card">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="giftcard">
    <main class="page-width page-width--narrow giftcard__wrap">
      <img src="{{ 'logo.jpg' | asset_url }}" alt="{{ shop.name | escape }}" width="150" height="132" class="giftcard__logo">
      <h1 class="page-title page-title--center">{{ 'gift_cards.issued.title' | t: value: value, shop: shop.name }}</h1>
      <div class="giftcard__card">
        <p class="giftcard__balance">{{ gift_card.balance | money }}</p>
        {%- if gift_card.expired -%}
          <p class="badge badge--muted">{{ 'gift_cards.issued.expired' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign expiry = gift_card.expires_on | date: '%d %B %Y' -%}
          <p>{{ 'gift_cards.issued.expires_on' | t: expires_on: expiry }}</p>
        {%- endif -%}
        <p class="field-label">{{ 'gift_cards.issued.code' | t }}</p>
        <p class="giftcard__code">{{ gift_card.code | format_code }}</p>
        <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      </div>
      <p class="giftcard__actions">
        <a href="{{ shop.url }}" class="button button--primary">{{ 'gift_cards.issued.shop_link' | t }}</a>
        <button type="button" class="button button--ghost-dark" onclick="window.print()">{{ 'gift_cards.issued.print' | t }}</button>
      </p>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (el && window.QRCode) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
