<section class="section section--tight">
  <div class="page-width auth">
    <div class="auth__card">
      <h1 class="page-title page-title--center">{{ 'customer.activate_account.title' | t }}</h1>
      <p>{{ 'customer.activate_account.subtext' | t }}</p>
      {%- form 'activate_customer_password', class: 'auth__form' -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field-wrap">
          <label class="field-label" for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
          <input class="field" type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password" required>
        </div>
        <div class="field-wrap">
          <label class="field-label" for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
          <input class="field" type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password" required>
        </div>
        <button type="submit" class="button button--primary button--full">{{ 'customer.activate_account.submit' | t }}</button>
        <button type="submit" name="decline" class="button button--ghost-dark button--full">{{ 'customer.activate_account.cancel' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>
