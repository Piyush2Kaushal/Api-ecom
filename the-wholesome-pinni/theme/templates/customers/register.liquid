<section class="section section--tight">
  <div class="page-width auth">
    <div class="auth__card">
      <h1 class="page-title page-title--center">{{ 'customer.register.title' | t }}</h1>
      {%- form 'create_customer', novalidate: 'novalidate', class: 'auth__form' -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field-wrap">
          <label class="field-label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
          <input class="field" type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name" value="{{ form.first_name }}">
        </div>
        <div class="field-wrap">
          <label class="field-label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
          <input class="field" type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name" value="{{ form.last_name }}">
        </div>
        <div class="field-wrap">
          <label class="field-label" for="RegisterEmail">{{ 'customer.login.email' | t }}</label>
          <input class="field" type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" value="{{ form.email }}" required>
        </div>
        <div class="field-wrap">
          <label class="field-label" for="RegisterPassword">{{ 'customer.login.password' | t }}</label>
          <input class="field" type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required>
        </div>
        <button type="submit" class="button button--primary button--full">{{ 'customer.register.submit' | t }}</button>
        <p class="auth__alt"><a href="{{ routes.account_login_url }}">{{ 'customer.login.title' | t }}</a></p>
      {%- endform -%}
    </div>
  </div>
</section>
