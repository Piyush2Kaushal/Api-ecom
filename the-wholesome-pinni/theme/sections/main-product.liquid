{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_media | default: product.featured_media
  assign threshold_money = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros
  assign form_id = 'ProductForm-' | append: section.id
-%}
<section class="section section--product" data-product-section data-section-id="{{ section.id }}" data-product-url="{{ product.url }}">
  <div class="page-width">
    {% render 'breadcrumbs' %}
    <div class="product">
      <div class="product__gallery" data-gallery>
        <div class="product__main" data-gallery-main>
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              {%- liquid
                assign is_active = false
                if media.id == featured.id
                  assign is_active = true
                endif
              -%}
              <div class="product__slide{% if is_active %} is-active{% endif %}" data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    {%- if forloop.first -%}{%- assign load = 'eager' -%}{%- else -%}{%- assign load = 'lazy' -%}{%- endif -%}
                    <div class="product__zoom">
                      {{ media | image_url: width: 1600 | image_tag: loading: load, widths: '500, 750, 1000, 1300, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title }}
                    </div>
                  {%- when 'video' -%}
                    {{ media | video_tag: controls: true, image_size: '1200x', class: 'product__video' }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag: class: 'product__video' }}
                  {%- else -%}
                    {{ media | media_tag }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="product__slide is-active">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <ul class="product__thumbs" role="list">
            {%- for media in product.media -%}
              <li>
                <button type="button" class="product__thumb{% if media.id == featured.id %} is-active{% endif %}" data-thumb="{{ media.id }}" aria-label="{{ 'products.product.thumbnail_label' | t: index: forloop.index }}"{% if media.id == featured.id %} aria-current="true"{% endif %}>
                  {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: media.alt | default: product.title, width: 100, height: 100 }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'title' -%}
              <div {{ block.shopify_attributes }}>
                {%- if product.type != blank -%}<p class="eyebrow">{{ product.type | escape }}</p>{%- endif -%}
                <h1 class="product__title">{{ product.title | escape }}</h1>
              </div>
            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }} data-price-wrap>
                {% render 'price', product: product, variant: current_variant, show_badge: true %}
                <p class="product__tax">
                  {%- if cart.taxes_included -%}{{ 'products.product.tax_included' | t }} {% endif -%}
                  {%- assign shipping_url = shop.shipping_policy.url | default: routes.root_url -%}
                  {{- 'products.product.shipping_at_checkout_html' | t: link: shipping_url -}}
                </p>
              </div>
            {%- when 'stock' -%}
              <div {{ block.shopify_attributes }} data-stock-wrap>{% render 'stock-status', variant: current_variant %}</div>
            {%- when 'text' -%}
              <div class="product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="variant-picker" {{ block.shopify_attributes }} data-variant-picker>
                  {%- for option in product.options_with_values -%}
                    <fieldset class="variant-picker__group">
                      <legend class="variant-picker__legend">{{ option.name | escape }}: <span data-option-value="{{ forloop.index0 }}">{{ option.selected_value | escape }}</span></legend>
                      <div class="variant-picker__pills">
                        {%- assign option_index = forloop.index0 -%}
                        {%- for value in option.values -%}
                          <input type="radio" class="visually-hidden" id="Opt-{{ section.id }}-{{ option_index }}-{{ forloop.index0 }}" name="option{{ option_index }}-{{ section.id }}" value="{{ value | escape }}" data-option-index="{{ option_index }}"{% if option.selected_value == value %} checked{% endif %}>
                          <label for="Opt-{{ section.id }}-{{ option_index }}-{{ forloop.index0 }}" class="pill">{{ value | escape }}</label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </div>
              {%- endunless -%}
            {%- when 'buy_buttons' -%}
              <div class="product__buy" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: form_id, class: 'product-form', data-product-form: '', novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                  <div class="product-form__row">
                    <div class="qty" data-qty>
                      <button type="button" class="qty__btn" data-qty-minus aria-label="{{ 'products.product.decrease_quantity' | t }}">{% render 'icon', name: 'minus', size: 16 %}</button>
                      <label class="visually-hidden" for="Qty-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                      <input class="qty__input" id="Qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                      <button type="button" class="qty__btn" data-qty-plus aria-label="{{ 'products.product.increase_quantity' | t }}">{% render 'icon', name: 'plus', size: 16 %}</button>
                    </div>
                    {%- liquid
                      assign can_buy = false
                      if current_variant.available and current_variant.price > 0
                        assign can_buy = true
                      endif
                    -%}
                    <button type="submit" class="button button--primary button--full" data-add-button{% unless can_buy %} disabled{% endunless %}>
                      <span data-add-label>{%- if can_buy -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
                    </button>
                  </div>
                  {%- if block.settings.show_dynamic_checkout -%}
                    <div class="product-form__dynamic{% unless can_buy %} is-hidden{% endunless %}" data-dynamic-checkout>{{ form | payment_button }}</div>
                  {%- endif -%}
                  <p class="form-message form-message--error" data-form-error hidden></p>
                {%- endform -%}
                {%- if settings.free_shipping_threshold > 0 -%}
                  <p class="product__shipnote">{% render 'icon', name: 'truck', size: 20 %} {{ 'products.product.free_shipping_note' | t: amount: threshold_money }}</p>
                {%- endif -%}
              </div>
            {%- when 'collapsible' -%}
              {%- liquid
                assign content = ''
                case block.settings.source
                  when 'description'
                    assign content = product.description
                  when 'ingredients'
                    assign content = product.metafields.custom.ingredients | metafield_tag
                  when 'allergens'
                    assign content = product.metafields.custom.allergens | metafield_tag
                  when 'storage'
                    assign content = product.metafields.custom.storage | metafield_tag
                endcase
                if content == blank
                  assign content = block.settings.content
                endif
              -%}
              {%- if content != blank -%}
                <details class="accordion" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                  <summary class="accordion__title">{{ block.settings.heading | escape }} {% render 'icon', name: 'plus', size: 18 %}</summary>
                  <div class="accordion__content rte">{{ content }}</div>
                </details>
              {%- endif -%}
            {%- when 'trust' -%}
              <ul class="trust" role="list" {{ block.shopify_attributes }}>
                {%- if block.settings.item_1 != blank -%}<li>{% render 'icon', name: 'ghee', size: 28 %}<span>{{ block.settings.item_1 | escape }}</span></li>{%- endif -%}
                {%- if block.settings.item_2 != blank -%}<li>{% render 'icon', name: 'hand', size: 28 %}<span>{{ block.settings.item_2 | escape }}</span></li>{%- endif -%}
                {%- if block.settings.item_3 != blank -%}<li>{% render 'icon', name: 'truck', size: 28 %}<span>{{ block.settings.item_3 | replace: '[threshold]', threshold_money | escape }}</span></li>{%- endif -%}
              </ul>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-json>
    {
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "options": {{ v.options | json }},
            "available": {{ v.available | json }},
            "price": {{ v.price }},
            "price_html": {{ v.price | money | json }},
            "compare_at_price": {{ v.compare_at_price | default: 0 }},
            "compare_html": {{ v.compare_at_price | money | json }},
            "featured_media": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %},
            "tracked": {% if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' %}true{% else %}false{% endif %},
            "qty": {{ v.inventory_quantity | default: 0 }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "Product information",
  "class": "section-main-product",
  "blocks": [
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "stock", "name": "Stock status", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    {
      "type": "buy_buttons", "name": "Buy buttons", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show express checkout buttons", "default": true }
      ]
    },
    {
      "type": "text", "name": "Text",
      "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Handmade in small batches.</p>" } ]
    },
    {
      "type": "collapsible", "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Ingredients" },
        {
          "type": "select", "id": "source", "label": "Content source", "default": "custom",
          "options": [
            { "value": "description", "label": "Product description" },
            { "value": "ingredients", "label": "Metafield: custom.ingredients" },
            { "value": "allergens", "label": "Metafield: custom.allergens" },
            { "value": "storage", "label": "Metafield: custom.storage" },
            { "value": "custom", "label": "Text below only" }
          ]
        },
        { "type": "richtext", "id": "content", "label": "Fallback text", "info": "Shown when the selected source is empty." },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "trust", "name": "Trust badges", "limit": 1,
      "settings": [
        { "type": "text", "id": "item_1", "label": "Badge 1", "default": "Pure desi ghee" },
        { "type": "text", "id": "item_2", "label": "Badge 2", "default": "Handmade in small batches" },
        { "type": "text", "id": "item_3", "label": "Badge 3", "default": "Free UK delivery over [threshold]" }
      ]
    }
  ]
}
{% endschema %}
