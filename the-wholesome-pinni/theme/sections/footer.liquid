<footer class="footer">
  <div class="page-width">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="logo logo--footer">{% render 'logo', loading: 'lazy' %}</a>
        {%- if section.settings.about_text != blank -%}
          <div class="footer__about rte">{{ section.settings.about_text }}</div>
        {%- endif -%}
        {% render 'social-icons', class: 'social-icons--footer' %}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- assign fmenu = linklists[block.settings.menu] -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading | default: fmenu.title | escape }}</h2>
              <ul class="footer__links" role="list">
                {%- if fmenu.links.size > 0 -%}
                  {%- for link in fmenu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                {%- elsif block.settings.fallback == 'shop' -%}
                  <li><a href="{{ routes.collections_url }}/pinni">Pinni</a></li>
                  <li><a href="{{ routes.collections_url }}/panjeeri">Panjeeri</a></li>
                  <li><a href="{{ routes.collections_url }}/best-sellers">Best Sellers</a></li>
                  <li><a href="{{ routes.all_products_collection_url }}">Shop All</a></li>
                {%- else -%}
                  <li><a href="/pages/about-us">About Us</a></li>
                  <li><a href="/pages/contact">Contact Us</a></li>
                  {%- for policy in shop.policies -%}
                    <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </div>
          {%- when 'contact' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
              <ul class="footer__links footer__contact" role="list">
                {%- if settings.contact_email != blank -%}
                  <li><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email | escape }}</a></li>
                {%- endif -%}
                {%- if settings.contact_phone != blank -%}
                  <li><a href="tel:{{ settings.contact_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ settings.contact_phone | escape }}</a></li>
                {%- endif -%}
                {%- if settings.contact_hours != blank -%}
                  <li>{{ settings.contact_hours | escape }}</li>
                {%- endif -%}
                {%- if settings.contact_address != blank -%}
                  <li>{{ settings.contact_address | escape | newline_to_br }}</li>
                {%- endif -%}
              </ul>
              {%- if block.settings.text != blank -%}
                <div class="footer__note rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. {{ section.settings.copyright | escape }}
      </p>
      {%- if shop.policies.size > 0 -%}
        <ul class="footer__policies" role="list" aria-label="{{ 'layout.footer.policies' | t }}">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payments" role="list" aria-label="{{ 'layout.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "richtext",
      "id": "about_text",
      "label": "Brand text",
      "default": "<p>Nourishing tradition, one pinni at a time. Handmade in the UK with pure desi ghee, whole dry fruits and recipes passed down through generations of Punjabi kitchens.</p>"
    },
    { "type": "text", "id": "copyright", "label": "Copyright text", "default": "Handmade with love in the UK." },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" },
        {
          "type": "select",
          "id": "fallback",
          "label": "Links shown if menu is empty",
          "default": "shop",
          "options": [
            { "value": "shop", "label": "Shop links" },
            { "value": "help", "label": "Help & policy links" }
          ]
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact details",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
        { "type": "paragraph", "content": "Email, phone, hours and address are edited in Theme settings › Contact details." },
        { "type": "richtext", "id": "text", "label": "Extra text" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
