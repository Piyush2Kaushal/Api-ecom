<section class="section section--tight" data-cart-page>
  <div class="page-width">
    {% render 'breadcrumbs' %}
    <h1 class="page-title">{{ 'cart.general.title' | t }}</h1>
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="CartPageForm" class="cart-page">
        <div class="cart-page__items">
          {% render 'free-shipping-bar' %}
          {% render 'cart-line-items', context: 'page' %}
        </div>
        <aside class="cart-page__summary">
          {%- if section.settings.show_note and settings.cart_show_notes -%}
            <label for="CartNote" class="field-label">{{ 'cart.general.note' | t }}</label>
            <textarea id="CartNote" name="note" class="field" rows="3" data-cart-note>{{ cart.note }}</textarea>
          {%- endif -%}
          {%- for discount in cart.cart_level_discount_applications -%}
            <p class="drawer__row"><span>{{ 'cart.general.discount' | t }}: {{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money }}</span></p>
          {%- endfor -%}
          <p class="drawer__row drawer__subtotal"><span>{{ 'cart.general.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></p>
          <p class="drawer__small">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
          <noscript><button type="submit" name="update" class="button button--ghost-dark button--full">{{ 'cart.general.update' | t }}</button></noscript>
          <button type="submit" name="checkout" class="button button--primary button--full">{{ 'cart.general.checkout' | t }}</button>
          {%- if additional_checkout_buttons -%}
            <div class="cart-page__dynamic">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
          <a href="{{ routes.all_products_collection_url }}" class="link-arrow">{{ 'general.continue_shopping' | t }} {% render 'icon', name: 'arrow-right', size: 16 %}</a>
        </aside>
      </form>
    {%- else -%}
      <div class="empty-state">
        <span class="empty-state__icon">{% render 'icon', name: 'cart', size: 56 %}</span>
        <p class="empty-state__title">{{ 'cart.general.empty' | t }}</p>
        <p>{{ 'cart.general.empty_text' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button button--primary">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "class": "section-main-cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": true }
  ]
}
{% endschema %}
