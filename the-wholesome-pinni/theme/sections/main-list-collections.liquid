<section class="section section--tight">
  <div class="page-width">
    <h1 class="page-title page-title--center">{{ section.settings.heading | escape }}</h1>
    {%- if settings.show_motif -%}<span class="ornament">{% render 'icon', name: 'ornament', size: 120 %}</span>{%- endif -%}
    <ul class="tiles tiles--3" role="list">
      {%- for c in collections -%}
        {%- if c.products_count > 0 and c.handle != 'frontpage' -%}
          <li class="tile" data-animate>
            <a href="{{ c.url }}" class="tile__link">
              <div class="tile__media">
                {%- assign img = c.featured_image -%}
                {%- if img -%}
                  {{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', alt: img.alt | default: c.title }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="tile__body">
                <h2 class="tile__title">{{ c.title | escape }}</h2>
                <p class="tile__sub">{{ 'collections.general.product_count' | t: count: c.products_count }}</p>
                <span class="tile__cta">{{ 'general.view_all' | t }} {% render 'icon', name: 'arrow-right', size: 16 %}</span>
              </div>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "class": "section-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop our range" }
  ]
}
{% endschema %}
