<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
    <ul class="tiles tiles--{{ section.blocks.size | at_most: 4 }}" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image
          if img == blank and c != blank
            assign img = c.featured_image
          endif
          assign title = block.settings.title | default: c.title
          assign link = c.url | default: routes.all_products_collection_url
        -%}
        <li class="tile" data-animate {{ block.shopify_attributes }}>
          <a href="{{ link }}" class="tile__link">
            <div class="tile__media">
              {%- if img != blank -%}
                {{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw', alt: img.alt | default: title }}
              {%- else -%}
                {%- assign ph = forloop.index0 | modulo: 6 | plus: 1 -%}
                {{ 'collection-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="tile__body">
              <h3 class="tile__title">{{ title | escape }}</h3>
              {%- if block.settings.subtitle != blank -%}<p class="tile__sub">{{ block.settings.subtitle | escape }}</p>{%- endif -%}
              <span class="tile__cta">{{ 'general.view_all' | t }} {% render 'icon', name: 'arrow-right', size: 16 %}</span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Our products (categories)",
  "class": "section-tiles",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Our products" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made the way Nani made them" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>From wholesome atta pinni to nutty alsi panjeeri – every recipe is rooted in Punjabi tradition.</p>" },
    { "type": "checkbox", "id": "alt_bg", "label": "Peach background", "default": false }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional – overrides the collection image." },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" }
      ]
    }
  ],
  "presets": [
    { "name": "Our products (categories)", "blocks": [ { "type": "category" }, { "type": "category" }, { "type": "category" } ] }
  ]
}
{% endschema %}
