<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
    <ul class="testimonials" role="list">
      {%- for block in section.blocks -%}
        <li class="testimonial" data-animate {{ block.shopify_attributes }}>
          <span class="testimonial__quote-icon">{% render 'icon', name: 'quote', size: 32 %}</span>
          <div class="testimonial__stars" role="img" aria-label="{{ 'accessibility.rating' | t: rating: block.settings.rating }}">
            {%- for i in (1..5) -%}
              <span class="{% if i <= block.settings.rating %}is-on{% endif %}">{% render 'icon', name: 'star', size: 16 %}</span>
            {%- endfor -%}
          </div>
          <blockquote class="testimonial__text">{{ block.settings.quote }}</blockquote>
          <p class="testimonial__author">
            <strong>{{ block.settings.author | escape }}</strong>
            {%- if block.settings.location != blank -%}<span>{{ block.settings.location | escape }}</span>{%- endif -%}
          </p>
          {%- if block.settings.product != blank -%}
            <a class="testimonial__product" href="{{ block.settings.product.url }}">{{ block.settings.product.title | escape }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "class": "section-testimonials",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Kind words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by families across the UK" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "alt_bg", "label": "Peach background", "default": false }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>Tastes exactly like the pinni my mum used to make every winter.</p>" },
        { "type": "text", "id": "author", "label": "Name", "default": "Customer name" },
        { "type": "text", "id": "location", "label": "Location" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "product", "id": "product", "label": "Product (optional)" }
      ]
    }
  ],
  "presets": [
    { "name": "Testimonials", "blocks": [ { "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" } ] }
  ]
}
{% endschema %}
