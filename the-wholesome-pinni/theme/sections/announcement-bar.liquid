{%- liquid
  assign threshold_money = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros
-%}
{%- if section.blocks.size > 0 -%}
  <div class="announcement" style="--ann-bg: {{ section.settings.background }}; --ann-fg: {{ section.settings.text_color }};" data-announcement data-interval="{{ section.settings.speed | times: 1000 }}">
    <div class="page-width announcement__inner">
      {%- for block in section.blocks -%}
        {%- liquid
          assign msg = block.settings.text | replace: '[threshold]', threshold_money
        -%}
        <p class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}{% unless forloop.first %} aria-hidden="true"{% endunless %}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ msg }}</a>
          {%- else -%}
            {{ msg }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 5,
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#5C1A1B" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F8E6D0" },
    { "type": "range", "id": "speed", "label": "Rotate every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free UK delivery on orders over [threshold]",
          "info": "Type [threshold] to insert the free shipping amount from Theme settings › Shipping & cart."
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free UK delivery on orders over [threshold]" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
