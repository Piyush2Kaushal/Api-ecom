<section class="password">
  <div class="page-width page-width--narrow password__inner">
    <div class="logo logo--password">{% render 'logo' %}</div>
    <p class="eyebrow">{{ 'general.password_page.opening_soon' | t }}</p>
    <h1 class="page-title page-title--center">{{ section.settings.heading | escape }}</h1>
    {%- if settings.show_motif -%}<span class="ornament">{% render 'icon', name: 'ornament', size: 120 %}</span>{%- endif -%}
    {%- if shop.password_message != blank -%}
      <div class="rte">{{ shop.password_message }}</div>
    {%- else -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'general.newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__field">
          <label class="visually-hidden" for="PasswordNewsletter">{{ 'general.newsletter.label' | t }}</label>
          <input id="PasswordNewsletter" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'general.newsletter.placeholder' | t }}">
          <button type="submit" class="button button--primary">{{ 'general.newsletter.subscribe' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>{{ 'general.password_page.login_form_heading' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}<p class="form-message form-message--error">{{ 'general.password_page.login_form_error' | t }}</p>{%- endif -%}
        <label class="field-label" for="StorePassword">{{ 'general.password_page.login_form_password_label' | t }}</label>
        <div class="newsletter__field">
          <input class="field" id="StorePassword" type="password" name="password" autocomplete="current-password" required>
          <button type="submit" class="button button--primary">{{ 'general.password_page.login_password_button' | t }}</button>
        </div>
      {%- endform -%}
      <p class="password__admin">{{ 'general.password_page.admin_link_html' | t }}</p>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "class": "section-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something sweet is coming" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Our kitchen is warming up. Sign up to be the first to know when we open.</p>" }
  ]
}
{% endschema %}
