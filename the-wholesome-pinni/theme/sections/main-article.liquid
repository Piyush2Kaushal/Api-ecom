<article class="section section--tight">
  <div class="page-width page-width--narrow">
    <a href="{{ blog.url }}" class="link-arrow link-arrow--back">{% render 'icon', name: 'chevron-left', size: 16 %} {{ 'blogs.article.back' | t }}</a>
    <h1 class="page-title page-title--center">{{ article.title | escape }}</h1>
    <p class="article__meta">{{ article.published_at | date: '%d %B %Y' }} · {{ 'blogs.article.by' | t: author: article.author }}</p>
    {%- if article.image -%}
      <div class="article__image">
        {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 860px, 100vw', alt: article.image.alt | default: article.title }}
      </div>
    {%- endif -%}
    <div class="rte page-content">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{ "name": "Blog post", "class": "section-main-article", "settings": [] }
{% endschema %}
