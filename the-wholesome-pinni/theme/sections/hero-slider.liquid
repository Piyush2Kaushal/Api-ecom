{%- liquid
  assign slide_count = section.blocks.size
-%}
<section class="hero hero--{{ section.settings.height }}" data-slider data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.speed | times: 1000 }}" aria-roledescription="carousel" aria-label="{{ section.settings.label | escape }}">
  <div class="hero__track" data-slider-track>
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <div class="hero__slide hero__slide--{{ b.text_align }}{% if forloop.first %} is-active{% endif %}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ slide_count }}" data-slide {{ block.shopify_attributes }} style="--overlay: {{ b.overlay | divided_by: 100.0 }};">
        <div class="hero__media">
          {%- if b.image != blank -%}
            {%- if forloop.first -%}{%- assign load = 'eager' -%}{%- assign prio = 'high' -%}{%- else -%}{%- assign load = 'lazy' -%}{%- assign prio = 'auto' -%}{%- endif -%}
            {%- if b.image_mobile != blank -%}
              <picture>
                <source media="(max-width: 749px)" srcset="{{ b.image_mobile | image_url: width: 750 }} 750w, {{ b.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
                {{ b.image | image_url: width: 2400 | image_tag: loading: load, fetchpriority: prio, widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', class: 'hero__img', alt: b.image.alt | default: b.heading }}
              </picture>
            {%- else -%}
              {{ b.image | image_url: width: 2400 | image_tag: loading: load, fetchpriority: prio, widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', class: 'hero__img', alt: b.image.alt | default: b.heading }}
            {%- endif -%}
          {%- else -%}
            <div class="hero__fallback" aria-hidden="true">
              <span class="hero__fallback-pinni"></span>
              <span class="hero__fallback-pinni"></span>
              <span class="hero__fallback-pinni"></span>
            </div>
          {%- endif -%}
        </div>
        <div class="page-width hero__content">
          <div class="hero__box">
            {%- if b.eyebrow != blank -%}<p class="eyebrow">{{ b.eyebrow | escape }}</p>{%- endif -%}
            {%- if b.heading != blank -%}
              {%- if forloop.first -%}<h1 class="hero__heading">{{ b.heading | escape }}</h1>{%- else -%}<h2 class="hero__heading">{{ b.heading | escape }}</h2>{%- endif -%}
            {%- endif -%}
            {%- if b.text != blank -%}<div class="hero__text">{{ b.text }}</div>{%- endif -%}
            <div class="hero__ctas">
              {%- if b.button_label != blank -%}<a href="{{ b.button_link | default: routes.all_products_collection_url }}" class="button button--primary">{{ b.button_label | escape }}</a>{%- endif -%}
              {%- if b.button_label_2 != blank -%}<a href="{{ b.button_link_2 | default: routes.all_products_collection_url }}" class="button button--ghost">{{ b.button_label_2 | escape }}</a>{%- endif -%}
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if slide_count > 1 -%}
    <div class="hero__controls">
      <button type="button" class="slider-btn" data-slider-prev>{% render 'icon', name: 'chevron-left', size: 20 %}<span class="visually-hidden">{{ 'general.slider.previous' | t }}</span></button>
      <div class="hero__dots" role="tablist">
        {%- for block in section.blocks -%}
          <button type="button" class="hero__dot{% if forloop.first %} is-active{% endif %}" data-slider-dot="{{ forloop.index0 }}" aria-label="{{ 'general.slider.go_to' | t: number: forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
        {%- endfor -%}
      </div>
      <button type="button" class="slider-btn" data-slider-next>{% render 'icon', name: 'chevron-right', size: 20 %}<span class="visually-hidden">{{ 'general.slider.next' | t }}</span></button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero slider",
  "tag": "div",
  "class": "section-hero",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible slideshow name", "default": "Featured pinni" },
    {
      "type": "select", "id": "height", "label": "Height", "default": "large",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ]
    },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "speed", "label": "Change slides every", "min": 4, "max": 12, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "2400 × 1200 px recommended. Brass plates or peach backdrops work beautifully." },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional. 750 × 1000 px portrait." },
        { "type": "range", "id": "overlay", "label": "Image darkening", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
        { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Handmade in the UK" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Taste of Punjab, made with love" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Traditional pinni and panjeeri slow-roasted in pure desi ghee and loaded with dry fruits.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop pinni" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "text", "id": "button_label_2", "label": "Second button label", "default": "Our story" },
        { "type": "url", "id": "button_link_2", "label": "Second button link" },
        {
          "type": "select", "id": "text_align", "label": "Content position", "default": "left",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Centre" },
            { "value": "right", "label": "Right" }
          ]
        }
      ]
    }
  ],
  "presets": [
    { "name": "Hero slider", "blocks": [ { "type": "slide" }, { "type": "slide" } ] }
  ]
}
{% endschema %}
