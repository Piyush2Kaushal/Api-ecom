{%- liquid
  assign limit = section.settings.limit
-%}
<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent=related">
  <div class="page-width">
    {% render 'section-heading', heading: section.settings.heading %}
    <ul class="grid grid--products" role="list" data-recommendations-grid>
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- for rec in recommendations.products -%}
          <li>{% render 'product-card', section_id: section.id, product: rec %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- assign shown = 0 -%}
        {%- for rec in collections.all.products -%}
          {%- if rec.id != product.id and shown < limit -%}
            <li>{% render 'product-card', section_id: section.id, product: rec %}</li>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "class": "section-related",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "alt_bg", "label": "Peach background", "default": true }
  ]
}
{% endschema %}
