{%- liquid
  assign source = section.settings.collection
  if source == blank or source.products_count == 0
    assign source = collections.all
  endif
  assign limit = section.settings.limit
-%}
<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
    {%- if source.products_count > 0 -%}
      <ul class="grid grid--products" role="list">
        {%- for product in source.products limit: limit -%}
          <li>{% render 'product-card', section_id: section.id, product: product, index: forloop.index0 %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <ul class="grid grid--products" role="list">
        {%- for i in (1..4) -%}
          <li>
            <article class="card">
              <div class="card__media" style="--ratio: 1.25"><div class="card__placeholder">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div></div>
              <div class="card__body"><h3 class="card__title">Pinni</h3></div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="section__cta">
        <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="button button--primary">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "class": "section-featured",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Best sellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our most-loved pinni" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "If empty, shows all products." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all" },
    { "type": "checkbox", "id": "alt_bg", "label": "Peach background", "default": false }
  ],
  "presets": [ { "name": "Featured products" } ]
}
{% endschema %}
