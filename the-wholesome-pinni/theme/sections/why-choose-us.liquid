{%- assign threshold_money = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros -%}
<section class="section section--{{ section.settings.style }}">
  <div class="page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
    <ul class="features" role="list">
      {%- for block in section.blocks -%}
        <li class="feature" data-animate {{ block.shopify_attributes }}>
          <span class="feature__icon">{% render 'icon', name: block.settings.icon, size: 44 %}</span>
          <h3 class="feature__title">{{ block.settings.title | replace: '[threshold]', threshold_money }}</h3>
          <p class="feature__text">{{ block.settings.text | replace: '[threshold]', threshold_money }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Why choose us",
  "class": "section-features",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Why choose us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Wholesome promise" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select", "id": "style", "label": "Style", "default": "dark",
      "options": [
        { "value": "plain", "label": "Cream" },
        { "value": "alt", "label": "Peach" },
        { "value": "dark", "label": "Maroon" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "leaf",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "ghee", "label": "Ghee pot" },
            { "value": "almond", "label": "Almond" },
            { "value": "heart", "label": "Heart" },
            { "value": "support", "label": "Support" },
            { "value": "truck", "label": "Delivery" },
            { "value": "hand", "label": "Handmade" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Authentic taste" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Family recipes from Punjab, unchanged for generations.", "info": "Type [threshold] to insert the free shipping amount." }
      ]
    }
  ],
  "presets": [
    { "name": "Why choose us", "blocks": [ { "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" } ] }
  ]
}
{% endschema %}
