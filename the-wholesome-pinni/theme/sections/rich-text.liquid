<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width page-width--narrow rich-text rich-text--{{ section.settings.align }}" data-animate>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="rich-text__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if settings.show_motif and section.settings.heading != blank -%}<span class="ornament">{% render 'icon', name: 'ornament', size: 120 %}</span>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.root_url }}" class="button button--primary">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "class": "section-rich-text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk about your brand" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share information about your brand with your customers.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "align", "label": "Alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" } ]
    },
    { "type": "checkbox", "id": "alt_bg", "label": "Peach background", "default": false }
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}
