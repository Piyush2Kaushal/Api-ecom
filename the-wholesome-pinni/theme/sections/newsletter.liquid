<section class="section section--newsletter">
  <div class="page-width">
    <div class="newsletter" data-animate>
      {%- if section.settings.heading != blank -%}<h2 class="newsletter__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="newsletter__text rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- assign form_id = 'NewsletterForm-' | append: section.id -%}
      {%- form 'customer', id: form_id, class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>{% render 'icon', name: 'check', size: 18 %} {{ 'general.newsletter.success' | t }}</p>
        {%- else -%}
          <div class="newsletter__field">
            <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'general.newsletter.label' | t }}</label>
            <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'general.newsletter.placeholder' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="NewsletterError-{{ section.id }}"{% endif %}>
            <button type="submit" class="button button--primary">{{ 'general.newsletter.subscribe' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p class="form-message form-message--error" id="NewsletterError-{{ section.id }}">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
      {%- if section.settings.small_print != blank -%}<p class="newsletter__small">{{ section.settings.small_print | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Wholesome family" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Be first to hear about fresh batches, festive gift boxes and family recipes.</p>" },
    { "type": "text", "id": "small_print", "label": "Small print", "default": "No spam – unsubscribe any time." }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
