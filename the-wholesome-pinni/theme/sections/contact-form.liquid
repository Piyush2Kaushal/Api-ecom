<section class="section section--tight">
  <div class="page-width">
    <div class="contact">
      <div class="contact__info" data-animate>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="split__heading">{{ section.settings.heading | escape }}</h2>
        {%- if settings.show_motif -%}<span class="ornament ornament--left">{% render 'icon', name: 'ornament', size: 120 %}</span>{%- endif -%}
        <div class="rte">{{ section.settings.text }}</div>
        <ul class="contact__list" role="list">
          {%- if settings.contact_email != blank -%}
            <li><span class="contact__label">Email</span><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email | escape }}</a></li>
          {%- endif -%}
          {%- if settings.contact_phone != blank -%}
            <li><span class="contact__label">Phone</span><a href="tel:{{ settings.contact_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ settings.contact_phone | escape }}</a></li>
          {%- endif -%}
          {%- if settings.contact_hours != blank -%}
            <li><span class="contact__label">Hours</span>{{ settings.contact_hours | escape }}</li>
          {%- endif -%}
          {%- if settings.contact_address != blank -%}
            <li><span class="contact__label">Address</span>{{ settings.contact_address | escape | newline_to_br }}</li>
          {%- endif -%}
        </ul>
        {% render 'social-icons' %}
      </div>

      <div class="contact__form-wrap" data-animate>
        {%- form 'contact', id: 'ContactForm', class: 'contact__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>{% render 'icon', name: 'check', size: 18 %} {{ 'contact.form.post_success' | t }}</p>
          {%- elsif form.errors -%}
            <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>
              <p>{{ 'contact.form.error_heading' | t }}</p>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
          <div class="field-grid">
            <div class="field-wrap">
              <label class="field-label" for="ContactName">{{ 'contact.form.name' | t }} <span aria-hidden="true">*</span></label>
              <input class="field" id="ContactName" type="text" name="contact[name]" autocomplete="name" required value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
            </div>
            <div class="field-wrap">
              <label class="field-label" for="ContactEmail">{{ 'contact.form.email' | t }} <span aria-hidden="true">*</span></label>
              <input class="field" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
            </div>
            <div class="field-wrap">
              <label class="field-label" for="ContactPhone">{{ 'contact.form.phone' | t }}</label>
              <input class="field" id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
            </div>
            <div class="field-wrap">
              <label class="field-label" for="ContactOrder">{{ 'contact.form.order' | t }}</label>
              <input class="field" id="ContactOrder" type="text" name="contact[order_number]" value="">
            </div>
          </div>
          <div class="field-wrap">
            <label class="field-label" for="ContactBody">{{ 'contact.form.message' | t }} <span aria-hidden="true">*</span></label>
            <textarea class="field" id="ContactBody" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="button button--primary">{{ 'contact.form.send' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "section-contact",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "We'd love to hear from you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    {
      "type": "richtext", "id": "text", "label": "Text",
      "default": "<p>Questions about an order, ingredients or gifting for a celebration? Send us a message and our family team will reply within one working day.</p>"
    }
  ],
  "presets": [ { "name": "Contact form" } ]
}
{% endschema %}
