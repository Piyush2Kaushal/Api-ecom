{%- comment -%}
  Product card. Params: product, section_id, index (for eager loading first rows), heading_tag
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign ratio = 1.25
  if settings.card_image_ratio == 'square'
    assign ratio = 1
  endif
  assign on_sale = false
  if variant.compare_at_price > variant.price and variant.price > 0
    assign on_sale = true
  endif
  assign loading = 'lazy'
  if index and index < 4
    assign loading = 'eager'
  endif
  assign tag = heading_tag | default: 'h3'
  assign single_variant = product.has_only_default_variant
-%}
<article class="card" data-animate>
  <a href="{{ product.url }}" class="card__media" style="--ratio: {{ ratio }}" aria-label="{{ product.title | escape }}" tabindex="-1">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 900 | image_tag:
        loading: loading,
        widths: '300, 450, 600, 750, 900',
        sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw',
        class: 'card__img card__img--primary',
        alt: product.featured_media.alt | default: product.title
      }}
      {%- if settings.card_show_second_image and product.media[1] -%}
        {{ product.media[1] | image_url: width: 900 | image_tag:
          loading: 'lazy',
          widths: '300, 450, 600, 750, 900',
          sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw',
          class: 'card__img card__img--secondary',
          alt: product.media[1].alt | default: product.title
        }}
      {%- endif -%}
    {%- else -%}
      <div class="card__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
    {%- endif -%}
    <div class="card__badges">
      {%- if product.available == false -%}
        <span class="badge badge--muted">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif on_sale -%}
        <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
      {%- endif -%}
    </div>
  </a>
  <div class="card__body">
    {%- if product.type != blank -%}<p class="card__eyebrow">{{ product.type | escape }}</p>{%- endif -%}
    <{{ tag }} class="card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></{{ tag }}>
    {% render 'price', product: product %}
    {%- if settings.card_show_quick_add -%}
      {%- if product.available and variant.price > 0 -%}
        {%- form 'product', product, class: 'card__form', data-product-form: '' -%}
          {%- if single_variant -%}
            <input type="hidden" name="id" value="{{ variant.id }}">
          {%- else -%}
            <label class="visually-hidden" for="CardVariant-{{ section_id }}-{{ product.id }}">{{ product.options.first | escape }}</label>
            <div class="select select--small">
              <select id="CardVariant-{{ section_id }}-{{ product.id }}" name="id" data-card-variant>
                {%- for v in product.variants -%}
                  <option value="{{ v.id }}"{% if v.id == variant.id %} selected{% endif %}{% unless v.available %} disabled{% endunless %} data-price="{{ v.price | money | escape }}">
                    {{- v.title | escape }} – {% if v.available %}{{ v.price | money | strip_html }}{% else %}{{ 'products.product.sold_out' | t }}{% endif -%}
                  </option>
                {%- endfor -%}
              </select>
              {% render 'icon', name: 'chevron-down', size: 14 %}
            </div>
          {%- endif -%}
          <button type="submit" class="button button--outline button--small button--full" data-add-button>
            <span data-add-label>{{ 'products.product.add_to_cart' | t }}</span>
          </button>
        {%- endform -%}
      {%- else -%}
        <button type="button" class="button button--outline button--small button--full" disabled>{{ 'products.product.sold_out' | t }}</button>
      {%- endif -%}
    {%- endif -%}
  </div>
</article>
