{%- comment -%} Progress toward free shipping. Uses the single theme setting settings.free_shipping_threshold. {%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
-%}
{%- if threshold > 0 -%}
  {%- liquid
    assign remaining = threshold | minus: cart.total_price
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  -%}
  <div class="ship-bar">
    <p class="ship-bar__text">
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ 'cart.general.free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {% render 'icon', name: 'check', size: 16 %} {{ 'cart.general.free_shipping_unlocked' | t }}
      {%- endif -%}
    </p>
    <div class="ship-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}"><span style="width: {{ pct }}%"></span></div>
  </div>
{%- endif -%}
