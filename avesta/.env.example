APP_NAME=Avesta
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.your-domain.co.uk
APP_TIMEZONE=Europe/London

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Database (cPanel → MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_avesta
DB_USERNAME=cpaneluser_avesta
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" sends emails immediately — simplest for cPanel, no worker needed.
QUEUE_CONNECTION=sync
CACHE_STORE=file

# --- Email (cPanel → Email Accounts, use the mailbox's SMTP details) ---
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.your-domain.co.uk
MAIL_PORT=465
MAIL_USERNAME=sales@avestatek.co.uk
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="sales@avestatek.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

# --- Stripe (dashboard.stripe.com → Developers → API keys / Webhooks) ---
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Only for testing without Stripe keys: marks orders as paid instantly. NEVER true on the live site.
PAYMENT_DEMO_MODE=false

# --- First admin login (created by `php artisan db:seed`) ---
ADMIN_EMAIL=admin@avesta.test
ADMIN_PASSWORD=ChangeMe123!

VITE_APP_NAME="${APP_NAME}"
